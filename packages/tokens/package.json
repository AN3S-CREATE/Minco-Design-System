{
  "name": "@minco/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens (CSS variables + JSON). Fill from website extraction — do not invent brand values.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css": "./src/tokens.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
